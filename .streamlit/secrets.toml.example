# Copy this file to .streamlit/secrets.toml (which is gitignored) and fill in
# your own key. On Streamlit Community Cloud, paste the same contents into
# App → Settings → Secrets instead of committing the file.

# Get/rotate a key at https://fredaccount.stlouisfed.org/apikeys
FRED_API_KEY = "your-fred-api-key-here"
